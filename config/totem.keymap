#include <input/processors.dtsi>
#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/totem.h"
#include <behaviors.dtsi>
#include <behaviors/num_word.dtsi>   // spinach-style SmartNum (auto-layer module)
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/* ── Layers ──────────────────────────────────────────────────────────────────
   Named rather than numbered, so the rest of the file reads in English.
   Kept deliberately short: every extra layer is another thing to remember. */
#define BASE   0
#define SYM    1
#define NUM    2
#define NAV    3
#define BRIDGE 4   // top letter row -> number row, "normal keyboard" mode
#define MOUSE  5   // toggled by the Smart Mouse combo, exits by itself
#define HYPER  6
#define FN     7

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4 LB5
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4 RB5
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2
#define ZMK_POINTING_DEFAULT_MOVE_VAL 3000
#define ZMK_POINTING_DEFAULT_SCRL_VAL 30

#define QUICK_TAP_MS 175

&sk {
    release-after-ms = <900>;
    quick-release;
};

&sl { ignore-modifiers; };

// SmartNum's num-word: which keys keep the number layer alive (numbers + these).
&num_word {
    continue-list = <BACKSPACE DELETE DOT COMMA PLUS MINUS EQUAL LBKT RBKT KP_SLASH STAR>;
    ignore-numbers;
    ignore-modifiers;
};

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <220>;
    quick-tap-ms = <220>;
    hold-trigger-key-positions = <0>;
};

&lt {
    flavor = "balanced";
    quick-tap-ms = <QUICK_TAP_MS>;
    tapping-term-ms = <200>;
};

/* ── Mouse emulation ─────────────────────────────────────────────────────────
   Speed scaling: hold Nav on top of the mouse layer for a fast "warp" cursor,
   hold Fn for slow precision. (Previously these pointed at the Number and an
   old Gaming layer, which was a leftover from the inherited config.) */
&mmv {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <500>;
    delay-ms = <0>;
};

&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <300>;
    delay-ms = <0>;
};

&mmv_input_listener {
    warp {
        layers = <NAV>;
        input-processors = <&zip_xy_scaler 3 1>;
    };

    precision {
        layers = <FN>;
        input-processors = <&zip_xy_scaler 1 2>;
    };
};

/ {
    zip_scroll_scaler: zip_scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        track-remainders;
    };
};

&msc_input_listener {
    warp {
        layers = <NAV>;
        input-processors = <&zip_scroll_scaler 2 1>;
    };

    precision {
        layers = <FN>;
        input-processors = <&zip_scroll_scaler 1 2>;
    };
};

#define U_MS_U &mmv MOVE_UP
#define U_MS_D &mmv MOVE_DOWN
#define U_MS_L &mmv MOVE_LEFT
#define U_MS_R &mmv MOVE_RIGHT
#define U_WH_U &msc SCRL_UP
#define U_WH_D &msc SCRL_DOWN
#define U_WH_L &msc SCRL_LEFT
#define U_WH_R &msc SCRL_RIGHT

/* ── Home-row mods ───────────────────────────────────────────────────────────
   Jacob's order — left pinky→index: Ctrl / Alt / Shift / Cmd, mirrored right.
   Defined via a macro so the combo hack below can reuse the same settings. */
#define MAKE_HRM(NAME, HOLD, TAP, TRIGGER_POS)                                 \
  ZMK_HOLD_TAP(NAME, bindings = <HOLD>, <TAP>; flavor = "balanced";            \
               tapping-term-ms = <280>; quick-tap-ms = <QUICK_TAP_MS>;         \
               require-prior-idle-ms = <150>; hold-trigger-on-release;         \
               hold-trigger-key-positions = <TRIGGER_POS>;)

MAKE_HRM(hml, &kp, &kp, KEYS_R THUMBS)
MAKE_HRM(hmr, &kp, &kp, KEYS_L THUMBS)

/* ── Space / Shift thumbs ────────────────────────────────────────────────────
   Both inner-ish thumbs type a space and become Shift when held. Positional,
   exactly like the home-row mods: the left space only shifts right-hand keys
   and the right space only shifts left-hand keys. That restriction is what
   stops fast typing throwing out stray capitals — a space rolled into a
   same-hand letter can only ever be a space. Having two is the point: whichever
   hand needs the capital, the other thumb has the Shift.

   Note there is deliberately NO require-prior-idle-ms here, unlike the home-row
   mods. You almost always want Shift immediately after typing something (the
   capital in "the Totem"), so a prior-idle guard would break the common case. */
#define MAKE_SPC(NAME, TRIGGER_POS)                                            \
  ZMK_HOLD_TAP(NAME, bindings = <&kp>, <&kp>; flavor = "balanced";             \
               tapping-term-ms = <200>; quick-tap-ms = <QUICK_TAP_MS>;         \
               hold-trigger-key-positions = <TRIGGER_POS>;)

MAKE_SPC(spcl, KEYS_R THUMBS)
MAKE_SPC(spcr, KEYS_L THUMBS)

/* Left outer pinky: tap = Escape, hold = Hyper layer. Deliberately
   "tap-preferred" rather than "balanced" so a quick tap is ALWAYS Escape, even
   if you brush another key while doing it. Escape is the job this key does
   most, so it wins ties; Hyper needs a deliberate hold. Every other layer
   leaves this position transparent, so Escape is available everywhere. */
ZMK_HOLD_TAP(esc_hyper, bindings = <&mo>, <&kp>; flavor = "tap-preferred";
             tapping-term-ms = <180>; quick-tap-ms = <QUICK_TAP_MS>;)

// Hack: make combos that overlap home-row mods tap-only (ZMK issue #544).
#define ZMK_COMBO_8(NAME, TAP, POS, LAYERS, COMBO_MS, IDLE_MS, HOLD, SIDE)     \
  MAKE_HRM(hm_combo_##NAME, &kp, TAP, SIDE THUMBS)                             \
  ZMK_COMBO_6(NAME, &hm_combo_##NAME HOLD 0, POS, LAYERS, COMBO_MS, IDLE_MS)

/ {
    behaviors {
        comma_semic: comma_semic {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_SEMIC";
            bindings = <&kp COMMA>, <&kp SEMI>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        dot_colon: dot_colon {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_COLON";
            bindings = <&kp DOT>, <&kp COLON>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        ex_que: ex_que {
            compatible = "zmk,behavior-mod-morph";
            label = "EX_QUE";
            bindings = <&kp EXCLAMATION>, <&kp QUESTION>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        // Combo brackets: tap = ( or ), shift + tap = < or >.
        lpar_lt: lpar_lt {
            compatible = "zmk,behavior-mod-morph";
            label = "LPAR_LT";
            bindings = <&kp LPAR>, <&kp LT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        rpar_gt: rpar_gt {
            compatible = "zmk,behavior-mod-morph";
            label = "RPAR_GT";
            bindings = <&kp RPAR>, <&kp GT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        swapper: swapper {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&kt LALT>, <&kp TAB>, <&kt LALT>;

            ignored-key-positions = <LT2 RT2 RM1 RM2 RM3>;
        };

        hold_sticky: hold_sticky {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_STICKY";
            bindings = <&kp>, <&sk>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        magic_shift: magic_shift {
            compatible = "zmk,behavior-tap-dance";
            label = "MAGIC_SHIFT";
            #binding-cells = <0>;
            bindings = <&hold_sticky LSHIFT LSHIFT>, <&caps_word>;
        };

        // --- SmartNum (spinach-style), triggered from one thumb key ---
        // tap = num-word (numbers stay till a non-number) | double-tap = sticky/lock
        // | hold = numbers while held. Invoke as: &smart_num NUM 0.
        num_dance: num_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "NUM_DANCE";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&num_word NUM>, <&sl NUM>;
        };

        smart_num: smart_num {
            compatible = "zmk,behavior-hold-tap";
            label = "SMART_NUM";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <QUICK_TAP_MS>;
            bindings = <&mo>, <&num_dance>;
        };

        // Smart Mouse: the F+P combo turns the mouse layer on, and it turns
        // itself back off as soon as you touch a key that isn't part of
        // mousing. No need to remember to exit.
        smart_mouse: smart_mouse {
            compatible = "zmk,behavior-tri-state";
            label = "SMART_MOUSE";
            #binding-cells = <0>;
            bindings = <&tog MOUSE>, <&none>, <&tog MOUSE>;

            ignored-key-positions =
                <LT1 LT2 LH0 LH1 RT1 RT2 RT3 RM0 RM1 RM2 RM3 RM4 RB1 RB2 RB3 RH0 RH1>;
            ignored-layers = <MOUSE NAV FN>;
        };
    };

    combos {
        compatible = "zmk,combos";
    };
};

/* Combos live in their own file so the build script can size the combo
   slots automatically, and so the printed diagram stays readable. */
#include "combos.dtsi"

/ {
    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
                &kp Q         &kp W        &kp F          &kp P        &kp B      &kp J                    &kp L          &kp U          &kp Y         &kp SQT
                &hml LCTRL A  &hml LALT R  &hml LSHIFT S  &hml LGUI T  &kp G      &kp M                    &hmr LGUI N    &hmr LSHIFT E  &hmr LALT I   &hmr LCTRL O
&esc_hyper HYPER ESC  &kp Z   &kp X        &kp C          &kp D        &kp V      &kp K                    &kp H          &comma_semic   &dot_colon    &ex_que          &mo FN
                                           &kp BSPC  &spcl LSHIFT SPACE  &lt NAV TAB   &lt SYM ENTER  &spcr LSHIFT SPACE  &smart_num NUM 0
            >;
        };

        Sym {
            display-name = "Sym";
            bindings = <
        &trans  &kp AT     &kp HASH         &kp DLLR         &kp PRCNT    &kp CARET      &kp PLUS          &kp ASTRK        &kp AMPERSAND  &trans
        &trans  &kp LBKT   &hml LCTRL LBRC  &hml LSHFT LPAR  &kp LT       &kp GT         &hmr LSHIFT RPAR  &hmr LCTRL RBRC  &kp RBKT       &kp SEMI
&trans  &trans  &kp GRAVE  &kp BSLH         &kp EQUAL        &kp TILDE    &kp UNDER      &kp MINUS         &kp SLASH        &kp PIPE       &trans    &trans
                           &trans           &kp DEL          &trans       &trans         &trans            &trans
            >;
        };

        // SmartNum's number layer — spinach's left-hand numpad. Left hand types the
        // digits (1-2-3 / 4-5-6 / 7-8-9, 0 on the left thumb); right home row = your
        // sticky mods (Cmd/Shift/Alt/Ctrl) so you can hold a modifier while the left
        // hand taps a number. Left pinky = minus (shift gives underscore).
        Num {
            display-name = "Num";
            bindings = <
        &kp LBKT  &kp N1    &kp N2    &kp N3    &kp RBKT       &trans   &trans      &trans      &trans     &trans
        &kp MINUS &kp N4    &kp N5    &kp N6    &kp EQUAL      &trans   &sk LGUI    &sk LSHIFT  &sk LALT   &sk LCTRL
&trans  &kp BSLH  &kp N7    &kp N8    &kp N9    &kp KP_SLASH   &trans   &trans      &trans      &trans     &trans     &trans
                            &kp N0    &trans    &trans         &trans   &trans      &trans
            >;
        };

        Nav {
            display-name = "Nav";
            bindings = <
        &swapper         &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp C_VOL_UP    &kp HOME        &kp PG_DN       &kp PG_UP     &kp END          &kp PRINTSCREEN
        &mt LGUI ESCAPE  &kp LALT    &kp LCTRL         &kp LSHIFT  &kp C_VOL_DN    &kp LEFT        &kp DOWN        &kp UP        &kp RIGHT        &trans
&trans  &kp LG(Z)        &kp LG(X)   &kp LG(C)         &kp LG(V)   &kp C_MUTE      &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans           &trans
                                     &trans            &trans      &trans          &kp BACKSPACE   &kp DELETE      &trans
            >;
        };

        // "Normal keyboard" mode. Toggled on and off by the Q+W combo — the
        // dongle screen shows "Bridge" while it's live so you can't get lost.
        // Top letter row becomes the number row, shift gives !@#$%^&*() exactly
        // where they sit on a laptop. Everything else is untouched.
        Bridge {
            display-name = "Bridge";
            bindings = <
        &kp N1  &kp N2  &kp N3  &kp N4  &kp N5     &kp N6  &kp N7  &kp N8  &kp N9  &kp N0
        &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans     &trans  &trans  &trans
            >;
        };

        // Reached by the Smart Mouse combo (F+P). Right hand drives the pointer,
        // bottom row clicks. Hold Nav for a fast cursor, Fn for precision.
        Mouse {
            display-name = "Mouse";
            bindings = <
        &trans  &trans  &trans  &trans  &trans     &trans   &kp PG_UP   U_MS_U     &kp PG_DN  &trans
        &trans  &trans  &trans  &trans  &trans     U_WH_L   U_MS_L      U_MS_D     U_MS_R     U_WH_R
&trans  &trans  &trans  &trans  &trans  &trans     &trans   &mkp LCLK   &mkp MCLK  &mkp RCLK  &trans  &trans
                        &trans  &trans  &trans     U_WH_U   U_WH_D      &trans
            >;
        };

        // Held by the left outer pinky key (tap = Escape). Mirrors the
        // Caps-Lock Hyper on Karabiner. For now: right home row N/E/I/O = arrows.
        // Real Shift-Cmd-Ctrl chords for app shortcuts land in the next round.
        Hyper {
            display-name = "Hyper";
            bindings = <
        &trans  &trans  &trans  &trans  &trans     &trans  &trans     &trans     &trans   &trans
        &trans  &trans  &trans  &trans  &trans     &trans  &kp LEFT   &kp DOWN   &kp UP   &kp RIGHT
&trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans     &trans     &trans   &trans     &trans
                        &trans  &trans  &trans     &trans  &trans     &trans
            >;
        };

        // Held by the right outer pinky key — plain function keys.
        Fn {
            display-name = "Fn";
            bindings = <
        &kp F1   &kp F2   &kp F3   &kp F4   &kp F5     &kp F6   &kp F7   &kp F8   &kp F9   &kp F10
        &kp F11  &kp F12  &trans   &trans   &trans     &trans   &trans   &trans   &trans   &trans
&trans  &trans   &trans   &trans   &trans   &trans     &trans   &trans   &trans   &trans   &trans   &trans
                          &trans   &trans   &trans     &trans   &trans   &trans
            >;
        };
    };
};
